{
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "valeo-b2b-mom",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b2b-mom",
      // From Cloudflare dashboard: Storage & databases > D1 > b2b-mom > Database ID
      "database_id": "1c5effcc-812b-424e-a8d1-d52d55310c9c"
    }
  ],
  "observability": { "enabled": true }
}
